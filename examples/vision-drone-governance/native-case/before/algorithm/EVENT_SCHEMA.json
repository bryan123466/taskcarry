{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "离线障碍物候选事件",
  "description": "算法侧提议的单帧单候选事件结构。",
  "type": "object",
  "required": ["frame_id", "label", "region", "confidence", "timestamp_ms"],
  "additionalProperties": false,
  "properties": {
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "description": "合成序列内的帧标识。多条候选可以引用同一帧。"
    },
    "label": {
      "type": "string",
      "enum": ["wall", "column", "box"],
      "description": "初步候选类别，分别表示墙面、立柱和箱体。"
    },
    "region": {
      "type": "object",
      "description": "相对于整帧图像归一化的轴对齐矩形，原点位于左上角，横轴向右，纵轴向下。读取时另行检查 x_min < x_max 和 y_min < y_max。",
      "required": ["x_min", "y_min", "x_max", "y_max"],
      "additionalProperties": false,
      "properties": {
        "x_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "y_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "x_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "y_max": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "候选分数。合成样例中的分数由人工设定。"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "相对合成序列起点的毫秒数，与所属帧一致。"
    }
  }
}
