{
  "contract_id": "rc8-drone-sim-v2",
  "schema_version": 2,
  "status": "design_baseline_pending_implementation_and_validation",
  "scope": "室内固定障碍的确定性二维合成仿真，运行于本地浏览器",
  "logical_clock": {
    "tick_ms": 100,
    "tick_start": 0,
    "max_ticks": 12,
    "timestamp_rule": "sim_time_ms = tick * tick_ms",
    "pause_policy": "暂停不推进节拍，恢复从原逻辑拍继续。"
  },
  "world": {
    "width_cells": 9,
    "height_cells": 9,
    "coordinate_origin": "左上，x 向右，y 向下",
    "movement_per_tick": "成功动作移动一个正交邻格",
    "initial_visit_count_at_start": 1,
    "collision_truth": "仿真器在收到命令后才根据固定场景核作碰撞判定。"
  },
  "camera": {
    "model": "北向固定的俯视局部相机模拟画面，随仿真位置居中",
    "width_px": 160,
    "height_px": 120,
    "pixel_format": "RGBA8",
    "data_order": "逐行连续，顶部到下部，每像素 R、G、B、A",
    "stride_bytes": 640,
    "buffer_bytes": 76800,
    "cells_x": 5,
    "cells_y": 5,
    "cell_width_px": 32,
    "cell_height_px": 24,
    "origin_cell": {
      "col": 2,
      "row": 2
    },
    "obstacle_inset_px": 2,
    "palette_rgba": {
      "background": [
        24,
        32,
        40,
        255
      ],
      "wall": [
        96,
        112,
        128,
        255
      ],
      "column": [
        220,
        90,
        50,
        255
      ],
      "box": [
        230,
        180,
        60,
        255
      ]
    },
    "grid_projection": "世界格对应相机 col = x - pose.x + 2，row = y - pose.y + 2，只画 col、row 均在 0 至 4 的视野格。",
    "drawing": "背景填充后按整像素网格画固定障碍矩形，每个矩形四边内缩 2 px。超出世界边界的视野格用 wall 色。检测叠框与文本在呈现层另画。",
    "detector_baseline": "只读取帧缓冲区，以已声明的类别颜色做 4 连通分量。少于 16 像素的分量丢弃。输出原图归一化半开边界框与像素数。",
    "minimum_component_pixels": 16,
    "box_coordinates": "x_min/y_min 为第一个像素坐标除以总宽/高，x_max/y_max 为最后像素坐标加 1 后再除以总宽/高。",
    "cell_projection": "col = floor(5 * (x_min + x_max) / 2)，row = floor(5 * (y_min + y_max) / 2)。dx = col - 2，dy = row - 2。",
    "hash_encoding": "以原 RGBA 字节做 FNV-1a 32-bit，起始 2166136261，逐字节 xor 后乘 16777619 取低 32 位，输出小写 8 位十六进制。独立测试同时做实际字节比较。"
  },
  "enum": {
    "labels": [
      "wall",
      "column",
      "box"
    ],
    "detection_status": [
      "ok",
      "missing",
      "invalid"
    ],
    "link_state": [
      "waiting",
      "connected",
      "disconnected"
    ],
    "run_state": [
      "ready",
      "running",
      "paused",
      "arrived",
      "collision",
      "timeout"
    ],
    "action": [
      "MOVE_N",
      "MOVE_E",
      "MOVE_S",
      "MOVE_W",
      "HOLD"
    ],
    "reason": [
      "toward_goal",
      "detour",
      "frame_missing",
      "link_disconnected",
      "invalid_frame",
      "no_safe_neighbor",
      "at_goal"
    ]
  },
  "movement": {
    "order": [
      "MOVE_N",
      "MOVE_E",
      "MOVE_S",
      "MOVE_W"
    ],
    "offsets": {
      "MOVE_N": {
        "dx": 0,
        "dy": -1
      },
      "MOVE_E": {
        "dx": 1,
        "dy": 0
      },
      "MOVE_S": {
        "dx": 0,
        "dy": 1
      },
      "MOVE_W": {
        "dx": -1,
        "dy": 0
      },
      "HOLD": {
        "dx": 0,
        "dy": 0
      }
    },
    "distance": "曼哈顿距离 |x - goal.x| + |y - goal.y|",
    "selection": "剔除越界邻格和检测为已占用的邻格。若有可缩短距离的邻格，按距离、访问次数、方向顺序选取。否则按访问次数、距离、方向顺序选取，或在无安全邻格时保持位置。",
    "valid_frame_reason": "有效帧时在目标点使用 HOLD/at_goal。选中的邻格缩短距离时用 toward_goal，否则用 detour。无可用邻格时用 HOLD/no_safe_neighbor。",
    "counter_policy": "visit_counts 由仿真器提供，按 y * 9 + x 排列。成功移动后才递增到达格计数。HOLD 保持计数。",
    "information_boundary": "控制只接收当前像素检测结果、调用方链接状态、位置、目标和访问计数。地图障碍列表供仿真器渲染及动作后判碰撞。"
  },
  "integration": {
    "js_global": "globalThis.RC8DroneSimV2",
    "input_call": "detectFrame(frameEnvelope)",
    "control_call": "chooseCommand(controlInput)",
    "browser_entry": "app/index.html",
    "packaging": "同目录经典脚本与本地资源可直接用 Chrome file: 打开。应用内静态嵌入与本协议同源的场景与配置。归档时附原字节 INTERFACE_CONTRACT.json 和摘要。"
  },
  "types": {
    "Position": {
      "x": "0 至 8 的整数",
      "y": "0 至 8 的整数"
    },
    "FrameEnvelope": {
      "scene_id": "scenes.id 之一",
      "tick": "从 0 起的整数",
      "sim_time_ms": "tick * 100",
      "frame": "null 表示此拍缺帧，或 RenderedFrame"
    },
    "RenderedFrame": {
