      "width_px": "160",
      "height_px": "120",
      "pixel_format": "RGBA8",
      "pixels": "内存 Uint8ClampedArray，长度恰为 76800"
    },
    "Detection": {
      "label": "enum.labels 之一",
      "region": {
        "x_min": "[0,1]",
        "y_min": "[0,1]",
        "x_max": "[0,1] 且大于 x_min",
        "y_max": "[0,1] 且大于 y_min"
      },
      "cell": {
        "dx": "-2 至 2 的整数",
        "dy": "-2 至 2 的整数"
      },
      "pixel_count": "连通块实际像素数，整数且至少 16"
    },
    "DetectionResult": {
      "scene_id": "与输入相同",
      "tick": "与输入相同",
      "sim_time_ms": "与输入相同",
      "frame_id": "有效帧 ID，missing 或 invalid 为 null",
      "status": "ok、missing 或 invalid",
      "detections": "Detection 数组，按 y_min、x_min、label 排序。missing 或 invalid 为 []。",
      "error": "invalid 时为说明字符串，ok 与 missing 为 null"
    },
    "ControlInput": {
      "detection": "DetectionResult",
      "link_state": "enum.link_state 之一，已经更新到当前拍",
      "pose": "动作前 Position",
      "goal": "Position",
      "visit_counts": "81 个非负整数"
    },
    "Command": {
      "tick": "DetectionResult.tick",
      "source_frame_id": "DetectionResult.frame_id 或 null",
      "action": "enum.action 之一",
      "reason": "enum.reason 之一"
    },
    "TickRecord": {
      "tick": "连续逻辑拍",
      "sim_time_ms": "tick * 100",
      "frame_digest": "有效帧的像素摘要，否则为 null",
      "pose_before": "Position",
      "pose_after": "Position",
      "detection": "DetectionResult",
      "link_state": "当前拍链路状态",
      "consecutive_unusable": "从最近一次有效帧至今连续不可用拍数",
      "link_event": "connected、disconnected、reconnected 或 null",
      "command": "实际使用的 Command",
      "run_state": "本拍执行后的运行状态",
      "collision": "布尔值",
      "arrived": "布尔值"
    },
    "Export": {
      "contract_id": "rc8-drone-sim-v2",
      "schema_version": "2",
      "scene_id": "实际运行的场景 ID",
      "start": "Position",
      "goal": "Position",
      "route": "按成功移动累加的 Position 数组，第一项为 start",
      "records": "按拍号排序的 TickRecord 数组，不携带原始像素",
      "run_state": "导出时状态",
      "clock_ms": "100"
    }
  },
  "transition_rules": [
    "每拍先根据姿态渲染像素或产生 null，再检测、更新链路、取控制命令，最后由仿真器应用移动并记录结果。",
    "检测为 ok 且 detections=[] 表示收到了有效空帧。frame=null 时返回 missing。坏 ID、格式、尺寸或长度返回 invalid。",
    "初始链路 waiting。第一个有效帧进入 connected。连续一拍不可用时保留现有连接状态，两拍进入 disconnected。下一有效帧清零并恢复为 connected。",
    "missing 或 invalid 拍采用 HOLD，清除当前候选。missing 在 disconnected 时使用 link_disconnected，否则使用 frame_missing。invalid 使用 invalid_frame。",
    "达到目标状态为 arrived。仿真碰撞状态为 collision，位置不前进。二者均停止推进。执行 12 拍且仍未终止时为 timeout，末拍索引为 11。",
    "暂停期间无新拍或日志。重置回到 ready、waiting、场景起点、初始访问计数和空日志。"
  ],
